(footprint "Pack_Frame"
	(version 20240108)
	(generator "makePack")
	(layer "F.Cu")
	(descr "The pack's printed frame (enclosure/generate.py): it holds the two magnets on this face and keys the pack in the window in the device's back; its pegs go into these holes. Printed, glued: not in the BOM or the CPL.")
	(attr exclude_from_pos_files exclude_from_bom)
	(property "Reference" "FR1" (at 0 0 0) (layer "F.Fab") (hide yes) (effects (font (size 0.6 0.6) (thickness 0.1))))
	(property "Value" "frame (print)" (at 0 0 0) (layer "F.Fab") (hide yes) (effects (font (size 0.6 0.6) (thickness 0.1))))
	(fp_line (start -7.170 -3.430) (end 7.170 -3.430) (stroke (width 0.1) (type solid)) (layer "F.Fab"))
	(fp_line (start -7.170 3.430) (end 7.170 3.430) (stroke (width 0.1) (type solid)) (layer "F.Fab"))
	(fp_arc (start 7.170 -3.430) (mid 10.600 0.000) (end 7.170 3.430) (stroke (width 0.1) (type solid)) (layer "F.Fab"))
	(fp_arc (start -7.170 3.430) (mid -10.600 0.000) (end -7.170 -3.430) (stroke (width 0.1) (type solid)) (layer "F.Fab"))
	(fp_rect (start 10.600 -2.515) (end 12.910 2.515) (fill no) (stroke (width 0.1) (type solid)) (layer "F.Fab"))
	(fp_circle (center -7.705 0.000) (end -6.117 0.000) (fill no) (stroke (width 0.1) (type solid)) (layer "F.Fab"))
	(fp_circle (center 7.705 0.000) (end 9.292 0.000) (fill no) (stroke (width 0.1) (type solid)) (layer "F.Fab"))
	(pad "" np_thru_hole circle (at -5.400 -2.400) (size 1.1 1.1) (drill 1.1) (layers "*.Cu" "*.Mask"))
	(pad "" np_thru_hole circle (at 5.400 -2.400) (size 1.1 1.1) (drill 1.1) (layers "*.Cu" "*.Mask"))
)
