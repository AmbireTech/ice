# Ambire Ice proto 0 radio: Ebyte E73-2G4M08S1C module (nRF52840).

CONFIG_ARM_MPU=y
CONFIG_HW_STACK_PROTECTION=y
CONFIG_GPIO=y
CONFIG_SERIAL=y
CONFIG_PINCTRL=y

# No bootloader: link the app into slot0_partition (from 0x0), so it can
# never grow into the settings storage behind it.
CONFIG_USE_DT_CODE_PARTITION=y

# The module has the 32 MHz crystal but no 32.768 kHz one: low-frequency clock
# from the internal RC oscillator, calibrated (the app's prj.conf asks for the
# same; set here too so any app on this board gets it).
CONFIG_CLOCK_CONTROL_NRF_K32SRC_RC=y

# Same 4-char tag scheme as Trezor's boards ("T3T2", little-endian): the
# STM32 side is built as model T3T2.
CONFIG_MODEL_IDENTIFIER=844378964
